{
  "kind": "collectionType",
  "collectionName": "configurations",
  "info": {
    "singularName": "configuration",
    "pluralName": "configurations",
    "displayName": "configuration",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "pagesNavigation": {
      "type": "json",
      "required": true
    },
    "LanguesDisponibles": {
      "type": "customField",
      "options": [
        "Français | fr",
        "English | en",
        "Español | es",
        ""
      ],
      "customField": "plugin::multi-select.multi-select"
    },
    "traduction": {
      "type": "json"
    },
    "noCookie": {
      "type": "text"
    },
    "Navigation_color": {
      "type": "string",
      "default": "#fff",
      "regex": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "adresse": {
      "type": "text"
    },
    "Phone_number": {
      "type": "string"
    },
    "background_color": {
      "type": "string",
      "regex": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    }
  }
}
